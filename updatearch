    def _setup_tray(self):
        self.tray_icon = QSystemTrayIcon(self)
        self.tray_icon.setIcon(make_tray_icon(count=0, reboot_needed=False))
        self.tray_icon.setToolTip("UpdateArch Guard\nInicializando monitor...")
        self.update_tray_menu([], False)
        self.tray_icon.activated.connect(self._on_tray_activated)
        self.tray_icon.show()

    def _on_tray_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.DoubleClick:
            # Duplo clique confirmado: cancela o timer de clique simples e abre a janela completa com logs
            if self._click_timer.isActive():
                self._click_timer.stop()
            self.show_and_activate()
        elif reason == QSystemTrayIcon.ActivationReason.Trigger:
            # Clique simples (botão esquerdo): aguarda breve intervalo para confirmar que não é duplo clique
            self._click_timer.start(240)
        elif reason == QSystemTrayIcon.ActivationReason.Context:
            # Clique com botão direito: tratado nativamente pelo Plasma através do menu da bandeja
            pass

    def _on_single_click_timeout(self):
        """Ao clicar uma vez no ícone com botão esquerdo: alterna visibilidade da janela principal ou abre menu."""
        if self.isVisible():
            self.hide()
        else:
            menu = self.tray_icon.contextMenu()
            if menu:
                try:
                    menu.popup(QCursor.pos())
                except Exception:
                    self.show_and_activate()
            else:
                self.show_and_activate()

    def trigger_background_check(self):
        if self._updates_worker and self._updates_worker.isRunning():
            return
        if self.worker and self.worker.isRunning():
            return

        self.tray_icon.setIcon(make_tray_icon(checking=True))
        self.tray_icon.setToolTip("UpdateArch Guard\nVerificando atualizações em segundo plano...")

        self._updates_worker = CheckUpdatesWorker()
        self._updates_worker.check_finished.connect(self.on_background_check_finished)
        self._updates_worker.check_failed.connect(self.on_background_check_failed)
        self._updates_worker.start()

    def on_background_check_finished(self, official: list, aur: list, reboot_needed: bool):
        all_pkgs = official + aur
        total = len(all_pkgs)
        self.tray_icon.setIcon(make_tray_icon(count=total, reboot_needed=reboot_needed))

        # Atualiza a prévia visual na janela completa e no menu nativo do tray
        self.populate_preview_list(all_pkgs)
        self.update_tray_menu(all_pkgs, reboot_needed)

        if reboot_needed:
            tip = f"UpdateArch Guard\n⚠️ Kernel atualizado! Reinicialização necessária.\nPacotes pendentes: {total}\n• Botão direito: menu rápido\n• Duplo clique: painel completo"
            self._set_banner_state("⚠️ REBOOT NECESSÁRIO (KERNEL / MICROCODE ATUALIZADO)", "reboot")
            self._set_reboot_button_highlight(True)
        elif total > 0:
            tip = f"UpdateArch Guard\n{total} atualização(ões) pendente(s):\n• {len(official)} oficial(is)\n• {len(aur)} AUR\n• Botão direito: menu rápido com lista e atualização\n• Duplo clique: logs do terminal"
            if not (self.worker and self.worker.isRunning()):
                self._set_banner_state(f"{total} ATUALIZAÇÃO(ÕES) DISPONÍVEIS ({len(official)} PACMAN, {len(aur)} AUR)", "warn")
        else:
            tip = "UpdateArch Guard\n✅ Sistema totalmente em dia\n• Botão direito: menu rápido\n• Duplo clique: painel de logs"
            if not (self.worker and self.worker.isRunning()):
                self._set_banner_state("SISTEMA TOTALMENTE EM DIA", "ok")

        self.tray_icon.setToolTip(tip)

        # Notificação nativa na área de notificação
        if reboot_needed:
            self.tray_icon.showMessage(
                "UpdateArch — Reinicialização Pendente",
                "O Kernel ou módulos em RAM foram substituídos. Reinicie o sistema.",
                QSystemTrayIcon.MessageIcon.Warning,
                6000
            )
        elif total > 0 and total != self._last_notified_count:
            resumo = f"{total} atualizações disponíveis ({len(official)} oficiais, {len(aur)} AUR)."
            self.tray_icon.showMessage(
                "UpdateArch — Atualizações do Arch",
                resumo,
                QSystemTrayIcon.MessageIcon.Information,
                5000
            )
            self._last_notified_count = total
        elif total == 0:
            self._last_notified_count = 0

    def on_background_check_failed(self, err_msg: str):
        self.tray_icon.setIcon(make_tray_icon(count=0, reboot_needed=False))
        self.tray_icon.setToolTip(f"UpdateArch Guard\nErro na verificação: {err_msg}")
        self.populate_preview_list([])
        self.update_tray_menu([], False)

    def closeEvent(self, event):
        """Ao clicar no X da janela, minimiza para o System Tray em vez de finalizar o processo."""
        if self._is_quitting:
            event.accept()
        else:
            event.ignore()
            self.hide()
            if not self._hide_notification_shown and self.tray_icon.isVisible():
                self.tray_icon.showMessage(
                    "UpdateArch Guard",
                    "O aplicativo continua em execução na bandeja do sistema.",
                    QSystemTrayIcon.MessageIcon.Information,
                    3000
                )
                self._hide_notification_shown = True

    def quit_application(self):
        """Encerra definitivamente o aplicativo e o ícone de bandeja."""
        self._is_quitting = True
        if self.worker and self.worker.isRunning():
            self.worker._is_killed = True
            self.worker.wait(1000)
        self.tray_icon.hide()
        QApplication.quit()


# ----------------------------------------------------------------------
# Ponto de Entrada com Suporte a Instância Única e Flag --tray
# ----------------------------------------------------------------------
def main():
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)

    socket_name = f"updatearch_{os.getuid()}"

    # 1. Checagem de Instância Única via QLocalSocket
    client_socket = QLocalSocket()
    client_socket.connectToServer(socket_name)
    if client_socket.waitForConnected(400):
        # Outra instância já está ativa: solicita exibição e encerra o novo processo
        client_socket.write(b"show\n")
        client_socket.waitForBytesWritten(400)
        client_socket.disconnectFromServer()
        sys.exit(0)

    # 2. Inicialização da Instância Principal
    window = UpdateArchWindow()

    # 3. Servidor Local para responder a novas chamadas do usuário
    local_server = QLocalServer()
    local_server.removeServer(socket_name)
    if local_server.listen(socket_name):
        def handle_new_connection():
            conn = local_server.nextPendingConnection()
            if conn:
                def read_cmd():
                    data = conn.readAll().data().decode("utf-8", errors="ignore").strip()
                    if data == "show":
                        window.show_and_activate()
                conn.readyRead.connect(read_cmd)
        local_server.newConnection.connect(handle_new_connection)

    # 4. Modo de exibição: Inicia minimizado no Tray se passado --tray ou -t
    start_in_tray = "--tray" in sys.argv or "-t" in sys.argv
    if not start_in_tray:
        window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
