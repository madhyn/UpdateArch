def resolve_pkg_icon(pkg_name: str) -> QIcon:
    """Resolve o melhor ícone para o pacote usando tema Breeze, desktop files e regras do sistema."""
    # 1. Nome direto no tema ativo
    if QIcon.hasThemeIcon(pkg_name):
        return QIcon.fromTheme(pkg_name)

    # 2. Desktop file associado em /usr/share/applications/
    candidates = (
        glob.glob(f"/usr/share/applications/{pkg_name}.desktop") +
        glob.glob(f"/usr/share/applications/*.{pkg_name}.desktop")
    )
    for c in candidates:
        try:
            with open(c, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if line.startswith("Icon="):
                        ic_val = line.strip().split("=", 1)[1]
                        if QIcon.hasThemeIcon(ic_val):
                            return QIcon.fromTheme(ic_val)
                        elif os.path.isfile(ic_val):
                            return QIcon(ic_val)
        except Exception:
            pass

    # 3. Regras de mapeamento especializadas
    clean_name = pkg_name.lower()
    if clean_name.startswith("lib32-"):
        clean_name = clean_name[6:]
    for key, ic_name in ARCHUPDATECHECKER_ICON_RULES:
        if clean_name == key or clean_name.startswith(key):
            if QIcon.hasThemeIcon(ic_name):
                return QIcon.fromTheme(ic_name)

    # 4. Fallbacks Freedesktop padrão do sistema
    for fallback in ["apdatifier-package", "package-x-generic", "server-database", "system-software-update"]:
        if QIcon.hasThemeIcon(fallback):
            return QIcon.fromTheme(fallback)

    return QIcon.fromTheme("system-software-update")


def parse_package_line(line: str, source: str = "Oficial") -> dict:
    """Extrai nome, versão anterior e nova versão da saída do checkupdates ou yay."""
    line = line.strip()
    m = re.match(r"^(\S+)\s+(\S+)\s+(?:->|→)\s+(\S+)", line)
    if m:
        return {
            "name": m.group(1),
            "old_ver": m.group(2),
            "new_ver": m.group(3),
            "source": source
        }
    parts = line.split()
    if parts:
        return {
            "name": parts[0],
            "old_ver": "",
            "new_ver": "",
            "source": source
        }
    return None


def make_pkg_row_widget(pkg: dict, icon: QIcon) -> QWidget:
    """Cria um card visual estilizado para exibição na lista de prévia de atualizações."""
    w = QWidget()
    h = QHBoxLayout(w)
    h.setContentsMargins(10, 5, 10, 5)
    h.setSpacing(12)

    # Ícone do Pacote
    icon_lbl = QLabel()
    icon_lbl.setFixedSize(26, 26)
    icon_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
    pm = icon.pixmap(24, 24)
    if not pm.isNull():
        icon_lbl.setPixmap(pm)
    h.addWidget(icon_lbl)

    # Detalhes: Nome e Versões
    info_box = QVBoxLayout()
    info_box.setSpacing(1)

    name_lbl = QLabel(pkg["name"])
    name_lbl.setStyleSheet("font-weight: bold; color: #ffffff; font-size: 13px; font-family: monospace;")
    info_box.addWidget(name_lbl)

    if pkg["old_ver"] and pkg["new_ver"]:
        ver_lbl = QLabel(f"{pkg['old_ver']}  →  {pkg['new_ver']}")
        ver_lbl.setStyleSheet(f"color: {TEXT_MUTED}; font-size: 11px; font-family: monospace;")
        info_box.addWidget(ver_lbl)

    h.addLayout(info_box, stretch=1)

    # Tag de Origem (Oficial vs AUR)
    badge = QLabel(pkg.get("source", "Oficial"))
    if pkg.get("source") == "AUR":
        badge.setStyleSheet(f"""
            background-color: {COLOR_YELLOW_BG};
            color: {COLOR_YELLOW};
            border: 1px solid #bb8009;
            border-radius: 3px;
            padding: 2px 7px;
            font-size: 10px;
            font-weight: bold;
        """)
    else:
        badge.setStyleSheet(f"""
            background-color: #162e4c;
            color: #58a6ff;
            border: 1px solid #1f6feb;
            border-radius: 3px;
            padding: 2px 7px;
            font-size: 10px;
            font-weight: bold;
        """)
    h.addWidget(badge)
    return w


