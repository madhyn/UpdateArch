def clean_ansi(text: str) -> str:
    """Remove sequências de controle ANSI, OSC e tokens de sessão systemd."""
    # Remove sequências OSC (Operating System Command): ESC ] ... (BEL ou ESC \)
    text = re.sub(r'\x1B\][^\x07\x1b]*(?:\x07|\x1b\\)?', '', text)
    # Remove sequências CSI padrão: ESC [ ...
    text = re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', text)
    # Remove tokens de integração de terminal/audit do systemd
    text = re.sub(r'3008;(?:start|end)=[a-f0-9]+[^\n]*\n?', '', text)
    lines = text.split('\n')
    processed = []
    for line in lines:
        if '\r' in line:
            parts = [p for p in line.split('\r') if p]
            candidate = parts[-1] if parts else ''
        else:
            candidate = line
        stripped = candidate.strip()
        # Ignora avisos cosméticos comuns que poluem o log
        if re.match(r'^(?:e?grep: (?:warning|aviso):|WARNING: Clamd was NOT notified)', stripped):
            continue
        processed.append(candidate)
    return '\n'.join(processed)


# ----------------------------------------------------------------------
# Thread para Execução Assíncrona e Leitura em Tempo Real via PTY
# ----------------------------------------------------------------------
class UpdateWorker(QThread):
    log_chunk = pyqtSignal(str)
    status_changed = pyqtSignal(str, str)  # (mensagem, tipo: "running" | "ok" | "reboot" | "warn" | "error")
    finished_execution = pyqtSignal(bool, bool)  # (sucesso_geral, reboot_necessario)

    def __init__(self, mode: str, use_yay: bool):
        super().__init__()
        self.mode = mode  # "update" ou "check_only"
        self.use_yay = use_yay
        self._is_killed = False

    def run(self):
        if self.mode == "update":
            self.run_full_update()
        else:
            self.run_check_only()

    def _execute_in_pty(self, command_str: str) -> int:
        """Executa um comando usando PTY para manter output interativo sem buffer."""
        master, slave = pty.openpty()
        proc = subprocess.Popen(
            command_str,
            shell=True,
            stdin=slave,
            stdout=slave,
            stderr=slave,
            close_fds=True,
            executable="/bin/bash"
        )
        os.close(slave)

        while True:
            if self._is_killed:
                proc.terminate()
                try:
                    proc.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    proc.kill()
                break
            r, _, _ = select.select([master], [], [], 0.1)
            if r:
                try:
                    data = os.read(master, 2048)
                    if not data:
                        break
                    decoded = data.decode("utf-8", errors="replace")
                    self.log_chunk.emit(decoded)
                except OSError:
                    break
            if proc.poll() is not None:
                # Esvazia qualquer byte residual
                try:
                    while True:
                        r, _, _ = select.select([master], [], [], 0.05)
                        if not r:
                            break
                        data = os.read(master, 2048)
                        if not data:
                            break
                        self.log_chunk.emit(data.decode("utf-8", errors="replace"))
                except OSError:
                    pass
                break

        os.close(master)
        return proc.wait()

    def run_full_update(self):
        self.status_changed.emit("ATUALIZANDO REPOSITÓRIOS OFICIAIS...", "running")
        self.log_chunk.emit("\n=== ETAPA 1/4: SINCRONIZAÇÃO E ATUALIZAÇÃO DO SISTEMA (PACMAN) ===\n")

        pacman_cmd = "sudo pacman -Syu --noconfirm"
        self.log_chunk.emit(f"Comando: {pacman_cmd}\n")
        pacman_code = self._execute_in_pty(pacman_cmd)

        aur_code = 0
        if pacman_code != 0:
            self.log_chunk.emit(f"\n❌ Falha na atualização dos repositórios oficiais (código {pacman_code}).\n")
        else:
            self.log_chunk.emit("\n✅ Repositórios oficiais atualizados com sucesso.\n")

        if self.use_yay and shutil.which("yay"):
            self.status_changed.emit("ATUALIZANDO PACOTES DO AUR...", "running")
            self.log_chunk.emit("\n=== ETAPA 2/4: ATUALIZAÇÃO DO AUR (YAY -Sua) ===\n")
            # MAKEFLAGS="-j4" previne exaustão de memória em pacotes de compilação pesada
            aur_cmd = 'MAKEFLAGS="-j4" yay -Sua --noconfirm'
            self.log_chunk.emit(f"Comando: {aur_cmd}\n")
            aur_code = self._execute_in_pty(aur_cmd)

            if aur_code != 0:
                self.log_chunk.emit(f"\n⚠️ Falha ou erro na compilação do AUR (código {aur_code}).\n")
                self.log_chunk.emit("O sistema base oficial permaneceu seguro e inalterado.\n")
            else:
                self.log_chunk.emit("\n✅ Pacotes do AUR atualizados com sucesso.\n")
        else:
            self.log_chunk.emit("\n=== ETAPA 2/4: AUR DESMARCADO / NÃO DISPONÍVEL ===\n")

        if shutil.which("rkhunter"):
            self.status_changed.emit("ATUALIZANDO BASE DO RKHUNTER...", "running")
            self.log_chunk.emit("\n=== ETAPA 3/4: ATUALIZAÇÃO DA BASE DO RKHUNTER ===\n")
            rkhunter_cmd = "sudo rkhunter --propupd"
            self.log_chunk.emit(f"Comando: {rkhunter_cmd}\n")
            rkhunter_code = self._execute_in_pty(rkhunter_cmd)
            if rkhunter_code != 0:
                self.log_chunk.emit(f"\n⚠️ Falha ao atualizar base do rkhunter (código {rkhunter_code}).\n")
            else:
                self.log_chunk.emit("\n✅ Base do rkhunter atualizada.\n")
        else:
            self.log_chunk.emit("\n=== ETAPA 3/4: RKHUNTER NÃO INSTALADO (IGNORADO) ===\n")

        self.status_changed.emit("EXECUTANDO DIAGNÓSTICO (NEEDRESTART)...", "running")
        self.log_chunk.emit("\n=== ETAPA 4/4: DIAGNÓSTICO DO KERNEL E SERVIÇOS (NEEDRESTART) ===\n")
        reboot_needed, services = self.run_needrestart_diagnostics(emit_signals=False)

        # Determina o status consolidado
        if pacman_code != 0:
            self.status_changed.emit("❌ ERRO NA BASE DO SISTEMA", "error")
            self.finished_execution.emit(False, reboot_needed)
        elif aur_code != 0:
            if reboot_needed:
                self.status_changed.emit("⚠️ REBOOT NECESSÁRIO (AVISO: AUR COM FALHA)", "reboot")
            else:
                self.status_changed.emit("⚠️ ATUALIZADO (AVISO: AUR COM FALHA)", "warn")
            self.finished_execution.emit(True, reboot_needed)
        elif reboot_needed:
            self.status_changed.emit("⚠️ REBOOT NECESSÁRIO (KERNEL / MICROCODE ATUALIZADO)", "reboot")
            self.finished_execution.emit(True, True)
        elif services:
            self.status_changed.emit("ℹ️ SERVIÇOS ANTIGOS NA RAM (REBOOT OPCIONAL)", "warn")
            self.finished_execution.emit(True, False)
        else:
            self.status_changed.emit("✅ SISTEMA TOTALMENTE EM DIA (REBOOT NÃO NECESSÁRIO)", "ok")
            self.finished_execution.emit(True, False)

    def run_check_only(self):
        self.status_changed.emit("EXECUTANDO DIAGNÓSTICO...", "running")
        self.log_chunk.emit("\n=== VERIFICANDO ESTADO DOS SERVIÇOS E KERNEL (NEEDRESTART) ===\n")
        self.run_needrestart_diagnostics(emit_signals=True)

    def run_needrestart_diagnostics(self, emit_signals: bool = True):
        # 1. Executa visual legível no log
        cmd_readable = "sudo needrestart -r l < /dev/null"
        self._execute_in_pty(cmd_readable)

        # 2. Executa em batch para parsing determinístico
        self.log_chunk.emit("\n--- Coletando parâmetros do kernel e microcódigo ---\n")
        try:
            batch_out = subprocess.check_output(["sudo", "needrestart", "-b"], text=True)
        except Exception as e:
            batch_out = ""
            self.log_chunk.emit(f"Aviso ao ler needrestart -b: {e}\n")

        ksta = 1
        ucsta = 1
        services_to_restart = []

        for line in batch_out.splitlines():
            line = line.strip()
            if line.startswith("NEEDRESTART-KSTA:"):
                try:
                    ksta = int(line.split(":", 1)[1].strip())
                except ValueError:
                    pass
            elif line.startswith("NEEDRESTART-UCSTA:"):
                try:
                    ucsta = int(line.split(":", 1)[1].strip())
                except ValueError:
                    pass
            elif line.startswith("NEEDRESTART-SVC:"):
                svc = line.split(":", 1)[1].strip()
                if svc:
                    services_to_restart.append(svc)

        # Checagem secundária do Arch: diretório de módulos do kernel ativo
        running_kernel = os.uname().release
        modules_dir = f"/usr/lib/modules/{running_kernel}"
        kernel_modules_missing = not os.path.exists(modules_dir)

        reboot_needed = (ksta > 1) or (ucsta > 1) or kernel_modules_missing

        self.log_chunk.emit(f"\n[DIAGNÓSTICO FINAL]\n")
        self.log_chunk.emit(f"• Kernel em execução: {running_kernel}\n")
        self.log_chunk.emit(f"• Status Kernel (needrestart): {'OBSOLETO / REQUER REBOOT' if ksta > 1 else 'Atualizado'}\n")
        self.log_chunk.emit(f"• Módulos em disco: {'OK' if not kernel_modules_missing else 'REMOVIDOS / REBOOT OBRIGATÓRIO'}\n")
        self.log_chunk.emit(f"• Status Microcode: {'OBSOLETO / REQUER REBOOT' if ucsta > 1 else 'Atualizado'}\n")

        if services_to_restart:
            self.log_chunk.emit(f"• Serviços com bibliotecas antigas: {', '.join(services_to_restart)}\n")

        if emit_signals:
            if reboot_needed:
                self.status_changed.emit("⚠️ REBOOT NECESSÁRIO (KERNEL / MICROCODE ATUALIZADO)", "reboot")
                self.finished_execution.emit(True, True)
            elif services_to_restart:
                self.status_changed.emit("ℹ️ SERVIÇOS ANTIGOS NA RAM (REBOOT OPCIONAL)", "warn")
                self.finished_execution.emit(True, False)
            else:
                self.status_changed.emit("✅ SISTEMA TOTALMENTE EM DIA (REBOOT NÃO NECESSÁRIO)", "ok")
                self.finished_execution.emit(True, False)

        return reboot_needed, services_to_restart


