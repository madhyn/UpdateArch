# Thread de Checagem Leve em Segundo Plano (Sem Travar Pacman / Sem Sudo)
# ----------------------------------------------------------------------
class CheckUpdatesWorker(QThread):
    check_finished = pyqtSignal(list, list, bool)  # (official_pkgs, aur_pkgs, reboot_needed)
    check_failed = pyqtSignal(str)

    def run(self):
        official = []
        aur = []
        try:
            # 1. Checagem de pacotes oficiais via checkupdates (seguro, não trava pacman db.lck)
            if shutil.which("checkupdates"):
                res = subprocess.run(
                    ["checkupdates"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=60
                )
                if res.returncode == 0 and res.stdout:
                    for l in res.stdout.strip().splitlines():
                        parsed = parse_package_line(l, "Oficial")
                        if parsed:
                            official.append(parsed)

            # 2. Checagem de pacotes AUR via yay
            if shutil.which("yay"):
                res_aur = subprocess.run(
                    ["yay", "-Qua"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=60
                )
                if res_aur.returncode == 0 and res_aur.stdout:
                    for l in res_aur.stdout.strip().splitlines():
                        parsed = parse_package_line(l, "AUR")
                        if parsed:
                            aur.append(parsed)

            # 3. Checagem instantânea de necessidade de reboot (módulos do kernel em execução)
            running_kernel = os.uname().release
            modules_missing = not os.path.exists(f"/usr/lib/modules/{running_kernel}")

            self.check_finished.emit(official, aur, modules_missing)
        except Exception as e:
            self.check_failed.emit(str(e))


def make_tray_icon(count: int = 0, reboot_needed: bool = False, checking: bool = False) -> QIcon:
    """Gera um ícone dinâmico minimalista para a bandeja do sistema (Breeze / Arch)."""
    base = QIcon.fromTheme("system-software-update")
    if base.isNull() or not QIcon.hasThemeIcon("system-software-update"):
        base = QIcon.fromTheme("update-none")

    size = 48
    pixmap = base.pixmap(size, size)
    if pixmap.isNull():
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)

    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)

    if reboot_needed:
        # Alerta Vermelho: Kernel ou Microcódigo desatualizado em RAM
        badge_size = 20
        badge_rect = QRectF(size - badge_size, size - badge_size, badge_size, badge_size)
        painter.setBrush(QColor(COLOR_RED))
        painter.setPen(QPen(QColor(BG_COLOR), 2))
        painter.drawEllipse(badge_rect)
        painter.setPen(QColor("#ffffff"))
        font = QFont("sans-serif", 10, QFont.Weight.Bold)
        painter.setFont(font)
        painter.drawText(badge_rect, Qt.AlignmentFlag.AlignCenter, "!")
    elif count > 0:
        # Alerta Amarelo/Âmbar: Quantidade de pacotes pendentes
        txt = str(count) if count <= 99 else "99+"
        badge_w = 20 if len(txt) <= 2 else 26
        badge_h = 18
        badge_rect = QRectF(size - badge_w, size - badge_h, badge_w, badge_h)
        painter.setBrush(QColor(COLOR_YELLOW))
        painter.setPen(QPen(QColor(BG_COLOR), 1.5))
        painter.drawRoundedRect(badge_rect, 6, 6)
        painter.setPen(QColor(BG_COLOR))
        font = QFont("sans-serif", 9, QFont.Weight.Bold)
        painter.setFont(font)
        painter.drawText(badge_rect, Qt.AlignmentFlag.AlignCenter, txt)
    elif checking:
        # Ponto Ciano: Varredura em andamento
        dot_size = 12
        dot_rect = QRectF(size - dot_size, size - dot_size, dot_size, dot_size)
        painter.setBrush(QColor(COLOR_CYAN))
        painter.setPen(QPen(QColor(BG_COLOR), 1.5))
        painter.drawEllipse(dot_rect)
    else:
        # Ponto Verde: Sistema 100% atualizado
        dot_size = 12
        dot_rect = QRectF(size - dot_size, size - dot_size, dot_size, dot_size)
        painter.setBrush(QColor(COLOR_GREEN))
        painter.setPen(QPen(QColor(BG_COLOR), 1.5))
        painter.drawEllipse(dot_rect)

    painter.end()
    return QIcon(pixmap)


