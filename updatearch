# Janela Principal do Aplicativo (Painel Completo com Logs e Needrestart)
# ----------------------------------------------------------------------
class UpdateArchWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("UpdateArch — Arch Linux System & Reboot Guard")
        self.resize(920, 640)
        self.setMinimumSize(780, 520)

        self.worker = None
        self._updates_worker = None
        self._is_quitting = False
        self._hide_notification_shown = False
        self._last_notified_count = -1

        # Timer para diferenciar clique simples (menu) de duplo clique (janela completa)
        self._click_timer = QTimer(self)
        self._click_timer.setSingleShot(True)
        self._click_timer.timeout.connect(self._on_single_click_timeout)

        # Timer para manter as credenciais sudo ativas enquanto a janela estiver aberta
        self.sudo_keepalive = QTimer(self)
        self.sudo_keepalive.setInterval(60 * 1000)  # Cada 60 segundos
        self.sudo_keepalive.timeout.connect(self._refresh_sudo)
        self.sudo_keepalive.start()

        # Timer periódico para checagem em segundo plano (a cada 60 minutos)
        self.check_timer = QTimer(self)
        self.check_timer.setInterval(60 * 60 * 1000)
        self.check_timer.timeout.connect(self.trigger_background_check)
        self.check_timer.start()

        self._setup_ui()
        self._apply_styles()
        self._setup_tray()

        # Dispara checagem inicial leve após 1.5s
        QTimer.singleShot(1500, self.trigger_background_check)

